-- --- HIỆU ỨNG (ANIMATIONS) ---

GetKeyBtn.MouseEnter:Connect(function()
    TweenService:Create(GetKeyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(55, 55, 70)}):Play()
end)
GetKeyBtn.MouseLeave:Connect(function()
    TweenService:Create(GetKeyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}):Play()
end)

SubmitBtn.MouseEnter:Connect(function()
    TweenService:Create(SubmitBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(185, 28, 28)}):Play()
end)
SubmitBtn.MouseLeave:Connect(function()
    TweenService:Create(SubmitBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(220, 38, 38)}):Play()
end)

local function ShowStatus(text, isSuccess)
    local mainColor = isSuccess and Color3.fromRGB(34, 197, 94) or Color3.fromRGB(239, 68, 68)
    local bgColor = isSuccess and Color3.fromRGB(15, 35, 20) or Color3.fromRGB(35, 15, 20)
    
    StatusMsg.Text = text
    StatusMsg.TextColor3 = mainColor
    StatusBadge.BackgroundColor3 = bgColor
    BadgeStroke.Color = mainColor
    
    TweenService:Create(StatusBadge, TweenInfo.new(0.25), {BackgroundTransparency = 0}):Play()
    TweenService:Create(BadgeStroke, TweenInfo.new(0.25), {Transparency = 0.3}):Play()
    TweenService:Create(StatusMsg, TweenInfo.new(0.25), {TextTransparency = 0}):Play()
end

local function ShakeFrame()
    local originalPos = UDim2.new(0.5, -200, 0.5, -135)
    local shakeOffset = 9
    local tweenInfo = TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    
    local offsets = {shakeOffset, -shakeOffset, shakeOffset * 0.7, -shakeOffset * 0.7, shakeOffset * 0.3, 0}
    for _, offset in ipairs(offsets) do
        local targetPos = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + offset, originalPos.Y.Scale, originalPos.Y.Offset)
        local tween = TweenService:Create(MainFrame, tweenInfo, {Position = targetPos})
        tween:Play()
        tween.Completed:Wait()
    end
end

-- --- XỬ LÝ SỰ KIỆN ---

-- Nút Get Key (Sao chép link https://link4m.net/W7hpF)
GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(GET_KEY_LINK)
    end
    ShowStatus("📋 Đã sao chép link Get Key vào Clipboard!", true)
end)

-- Nút Check Key
SubmitBtn.MouseButton1Click:Connect(function()
    local inputKey = KeyBox.Text
    
    if inputKey == CORRECT_KEY then
        -- Lưu Key lại để dùng cho lần sau
        SaveKeyData(inputKey)
        
        ShowStatus("✓ Key chính xác! Đang khởi chạy Chilli Hub V3...", true)
        
        TweenService:Create(MainStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(34, 197, 94)}):Play()
        task.wait(1.2)
        
        local fadeOut = TweenService:Create(MainFrame, TweenInfo.new(0.3), {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)})
        fadeOut:Play()
        fadeOut.Completed:Wait()
        
        ScreenGui:Destroy()
        loadstring(game:HttpGet("https://apexhubeditor.vercel.app/api/raw?name=6bzPiAYUA0ekyyvhOhxpPobkK643_chilli-hub-vit-ho-v3"))()
    else
        -- 1. Tự động xóa chữ
        KeyBox.Text = ""
        
        -- 2. Đổi màu viền
        TweenService:Create(KeyBoxStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(239, 68, 68)}):Play()
        
        -- 3. Báo lỗi đẹp
        ShowStatus("⚠️ KEY KHÔNG CHÍNH XÁC! VUI LÒNG THỬ LẠI", false)
        
        -- 4. Rung lắc menu
        ShakeFrame()
        
        task.wait(1)
        TweenService:Create(KeyBoxStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(45, 45, 55)}):Play()
    end
end)
