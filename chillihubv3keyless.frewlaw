local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

-- File cấu hình lưu key
local KEY_FILENAME = "ChilliHub_SavedKey.json"
local CORRECT_KEY = "ChilliHubHajwiwKey - Jalwpwouehejeejbeo"
local GET_KEY_LINK = "https://link4m.net/W7hpF"
local EXPIRE_SECONDS = 24 * 60 * 60 -- 24 Giờ (86400 giây)

-- Hàm hỗ trợ đọc/lưu File Key
local function SaveKeyData(key)
    if writefile then
        local data = {
            Key = key,
            Timestamp = os.time()
        }
        pcall(function()
            writefile(KEY_FILENAME, game:GetService("HttpService"):JSONEncode(data))
        end)
    end
end

local function LoadSavedKeyData()
    if isfile and readfile and isfile(KEY_FILENAME) then
        local success, result = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(KEY_FILENAME))
        end)
        if success and type(result) == "table" then
            return result
        end
    end
    return nil
end

-- Hàm kiểm tra tự động đăng nhập nếu key còn hạn 24h
local savedData = LoadSavedKeyData()
if savedData and savedData.Key == CORRECT_KEY and savedData.Timestamp then
    local currentTime = os.time()
    if (currentTime - savedData.Timestamp) < EXPIRE_SECONDS then
        -- Mật khẩu đúng và chưa hết 24 giờ -> Tải script luôn
        loadstring(game:HttpGet("https://apexhubeditor.vercel.app/api/raw?name=6bzPiAYUA0ekyyvhOhxpPobkK643_chilli-hub-vit-ho-v3"))()
        return
    end
end

-- Xóa UI cũ nếu đang chạy
if CoreGui:FindFirstChild("ChilliHubKeySystem") then
    CoreGui.ChilliHubKeySystem:Destroy()
end

